---
import projects from "../content/projects.json";
import { copy, type Lang } from "../i18n/copy";
const { lang = "en" }: { lang?: Lang } = Astro.props;
const t = copy[lang].work;
---

<section id="work" class="border-t border-rule px-[clamp(1.5rem,5vw,4rem)] py-[clamp(4rem,10vh,8rem)]">
  <div class="mb-16 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="mb-4 text-[0.68rem] uppercase tracking-[0.24em] text-teal">{t.eyebrow}</p>
      <h2 class="font-display text-[clamp(2rem,5vw,3.5rem)] font-normal leading-[1.1] text-fg">{t.heading}</h2>
    </div>
    <p class="max-w-[340px] text-[0.9rem] leading-[1.75] text-fg-dim">
      {t.body}
    </p>
  </div>

  <div id="work-track" class="work-track">
    {projects.map((item) => {
      const project = lang === "sw" ? { ...item, ...item.sw } : item;
      return (
      <a
        href={`${lang === "sw" ? "/sw" : ""}/work/${project.slug}`}
        data-track="cta_click"
        data-id={`work-card-${project.slug}`}
        class="auto-grid-320 grid cursor-pointer bg-canvas-mid no-underline transition-colors duration-300 hover:bg-card-hover focus-visible:outline-2 focus-visible:outline-teal focus-visible:outline-offset-4"
      >
        <div class="overflow-hidden bg-[#888] h-[280px]">
          <img
            src={project.image}
            alt={project.title}
            width="800"
            height="500"
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover transition-transform duration-500 hover:scale-[1.04]"
          />
        </div>
        <div class="flex flex-col justify-center p-10">
          <div class="mb-5 flex items-center gap-4">
            <span class="text-[0.62rem] uppercase tracking-[0.18em] text-teal">{project.category}</span>
            <span class="font-display text-[0.65rem] text-fg-dim">{project.id}</span>
          </div>
          <h3 class="font-display mb-4 text-[clamp(1.25rem,2.5vw,1.75rem)] font-normal leading-[1.2] text-fg">
            {project.title}
          </h3>
          <p class="mb-7 text-[0.875rem] leading-[1.8] text-fg-dim">{project.description}</p>
          <div class="flex flex-wrap gap-2">
            {project.tags.map((tag) => (
              <span class="rounded-sm border border-teal/30 px-2.5 py-1 text-[0.65rem] uppercase tracking-[0.1em] text-teal">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </a>
      );
    })}
  </div>

  <div class="work-nav">
    <button
      id="work-prev"
      aria-label={t.prevAria}
      class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-rule bg-transparent text-fg-dim transition-colors hover:border-teal hover:text-teal"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button
      id="work-next"
      aria-label={t.nextAria}
      class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-rule bg-transparent text-fg-dim transition-colors hover:border-teal hover:text-teal"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
  </div>

  <div class="mt-12 text-center">
    <p class="text-[0.8rem] tracking-[0.06em] text-fg-dim">
      {t.moreText}{" "}
      <a href="#contact" data-track="cta_click" data-id="work-contact" class="text-teal no-underline">{t.moreLink}</a>
    </p>
  </div>
</section>

<script is:inline>
  // Mobile carousel controls: scroll one card at a time.
  (function () {
    var track = document.getElementById("work-track");
    if (!track) return;
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    function step(dir) {
      var card = track.querySelector(":scope > a");
      var dx = card ? card.offsetWidth + 16 : 320;
      track.scrollBy({ left: dir * dx, behavior: reduce ? "auto" : "smooth" });
    }
    document.getElementById("work-prev")?.addEventListener("click", function () { step(-1); });
    document.getElementById("work-next")?.addEventListener("click", function () { step(1); });
  })();
</script>
