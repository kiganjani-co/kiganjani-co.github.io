---
import DarkModeToggle from "./DarkModeToggle";
import { copy, type Lang } from "../i18n/copy";
const { isHome = false, lang = "en" }: { isHome?: boolean; lang?: Lang } = Astro.props;
const t = copy[lang].nav;
// Section IDs stay constant — only labels translate.
const linkIds = ["services", "work", "process", "pricing", "about", "contact"];
const home = lang === "sw" ? "/sw/" : "/";
const prefix = isHome ? "" : home;
// Language counterparts derived from the current URL — no per-page wiring.
const path = Astro.url.pathname;
const enHref = lang === "sw" ? path.replace(/^\/sw/, "") || "/" : path;
const swHref = lang === "sw" ? path : path === "/" ? "/sw/" : `/sw${path}`;
const pillSeg = (active: boolean) =>
  active
    ? "rounded-full bg-teal/10 px-2.5 py-1 text-[0.7rem] font-semibold tracking-[0.08em] text-teal no-underline"
    : "rounded-full px-2.5 py-1 text-[0.7rem] font-semibold tracking-[0.08em] text-fg-dim no-underline transition-colors hover:text-fg";
---

<nav
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 flex h-16 items-center justify-between px-[clamp(1.5rem,5vw,4rem)] transition-all duration-300"
>
  <a href={home} class="flex items-center gap-2.5 no-underline">
    <img
      src="/logo.png"
      alt="Kiganjani Co."
      width="500"
      height="350"
      class="h-11 w-auto"
      data-logo
    />
  </a>

  <div class="hide-mobile flex items-center gap-10">
    {t.links.map((l, i) => (
      <a
        href={`${prefix}#${linkIds[i]}`}
        class="text-[0.75rem] uppercase tracking-[0.14em] text-fg-dim no-underline transition-colors hover:text-fg"
      >
        {l}
      </a>
    ))}

    <div class="flex items-center gap-2">
      <div role="group" aria-label={t.toggleLabel} class="flex items-center gap-1 rounded-full border border-rule p-1">
        <a href={enHref} aria-current={lang === "en" ? "true" : undefined} class={pillSeg(lang === "en")}>
          EN
        </a>
        <a href={swHref} aria-current={lang === "sw" ? "true" : undefined} class={pillSeg(lang === "sw")}>
          SW
        </a>
      </div>
      <DarkModeToggle client:load lang={lang} />
    </div>
  </div>

  <!-- Mobile row -->
  <div class="show-mobile flex items-center gap-2">
    <div role="group" aria-label={t.toggleLabel} class="flex items-center gap-1 rounded-full border border-rule p-1">
      <a href={enHref} aria-current={lang === "en" ? "true" : undefined} class={pillSeg(lang === "en")}>
        EN
      </a>
      <a href={swHref} aria-current={lang === "sw" ? "true" : undefined} class={pillSeg(lang === "sw")}>
        SW
      </a>
    </div>
    <DarkModeToggle client:load lang={lang} />
    <button
      id="mobile-menu-btn"
      class="border-none bg-transparent p-1 cursor-pointer"
      aria-label="Toggle menu"
    >
      <div class="flex w-[22px] flex-col gap-[5px]">
        <span class="block h-[1.5px] bg-fg transition-transform duration-200" id="bar-0"></span>
        <span class="block h-[1.5px] bg-fg transition-transform duration-200" id="bar-1"></span>
        <span class="block h-[1.5px] bg-fg transition-transform duration-200" id="bar-2"></span>
      </div>
    </button>
  </div>
</nav>

<!-- Mobile overlay -->
<div
  id="mobile-overlay"
  class="fixed inset-0 z-40 hidden flex-col items-center justify-center gap-10 bg-overlay-bg"
>
  {t.links.map((l, i) => (
    <a
      href={`${prefix}#${linkIds[i]}`}
      class="font-display text-4xl text-fg no-underline mobile-overlay-link"
    >
      {l}
    </a>
  ))}
  <a
    href="https://wa.me/255782506217?text=Hello%2C%20I%27m%20interested%20in%20your%20services"
    target="_blank"
    rel="noopener"
    data-track="whatsapp_click"
    data-placement="nav-mobile"
    class="flex items-center justify-center gap-3 rounded-sm bg-teal px-6 py-3 text-[0.9rem] font-medium tracking-[0.06em] text-canvas no-underline transition-colors hover:bg-mint mobile-overlay-link"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
    Send a text
  </a>
  <a
    href="tel:+255782506217"
    data-track="cta_click"
    data-id="nav-call"
    class="flex items-center gap-3 text-[0.9rem] tracking-[0.12em] text-teal no-underline mobile-overlay-link"
  >
    +255 782 506 217
  </a>
</div>

<script is:inline>
  // Mobile menu toggle
  const btn = document.getElementById("mobile-menu-btn");
  const overlay = document.getElementById("mobile-overlay");
  let menuOpen = false;

  function toggleMenu() {
    menuOpen = !menuOpen;
    if (menuOpen) {
      overlay.classList.remove("hidden");
      overlay.classList.add("flex");
      btn.classList.add("menu-open");
    } else {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
      btn.classList.remove("menu-open");
    }
  }

  btn?.addEventListener("click", toggleMenu);

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menuOpen) toggleMenu();
  });

  // Close on link click
  document.querySelectorAll(".mobile-overlay-link").forEach((link) => {
    link.addEventListener("click", () => {
      if (menuOpen) toggleMenu();
    });
  });

  // Nav scroll effect
  const nav = document.getElementById("site-nav");
  window.addEventListener("scroll", () => {
    nav.classList.toggle("is-scrolled", window.scrollY > 60);
  }, { passive: true });
</script>
