---
import { copy, type Lang } from "../i18n/copy";
const { lang = "en" }: { lang?: Lang } = Astro.props;
const t = copy[lang].pricing;
const pricing = t.plans;
---

<section id="pricing" class="border-t border-rule px-[clamp(1.5rem,5vw,4rem)] py-[clamp(4rem,10vh,8rem)]">
  <div class="mb-16">
    <p class="mb-4 text-[0.68rem] uppercase tracking-[0.24em] text-teal">{t.eyebrow}</p>
    <h2 class="font-display text-[clamp(2rem,5vw,3.5rem)] font-normal leading-[1.1] text-fg">
      {t.heading}
    </h2>
  </div>

  <div class="pricing-tabs" role="tablist" aria-label={t.tabsLabel}>
    {pricing.map((plan, i) => (
      <button
        role="tab"
        aria-selected={i === 0 ? "true" : "false"}
        data-pricing-tab={i}
        class="pricing-tab"
      >
        {plan.tier}
      </button>
    ))}
  </div>

  <div id="pricing-track" class="pricing-grid show-featured auto-grid-300 grid gap-px bg-rule">
    {pricing.map((plan) => (
      <div class={`group relative cursor-default bg-canvas p-10 transition-colors duration-200 hover:bg-card-hover${plan.featured ? " plan-featured-ring shadow-xl md:-my-5 md:py-14" : ""}`}>
        {plan.badge && (
          <p class="absolute right-4 top-4 rounded-sm bg-teal px-3 py-1 text-[0.62rem] font-semibold uppercase tracking-[0.14em] text-canvas">
            {plan.badge}
          </p>
        )}
        <p class="mb-6 text-[0.62rem] uppercase tracking-[0.18em] text-teal">{plan.tier}</p>
        <div class="mb-7 flex items-baseline gap-1.5">
          <span class="font-display text-[clamp(2rem,4vw,2.75rem)] font-normal text-fg">{plan.price}</span>
          <span class="text-[0.7rem] tracking-[0.08em] text-fg-dim">TZS</span>
        </div>
        <ul class="flex flex-col gap-3 list-none p-0 m-0">
          {plan.features.map((f) => (
            <li class="flex items-start gap-2.5 text-[0.82rem] leading-[1.5] text-fg-dim">
              <span class="mt-0.5 flex-shrink-0 text-teal">&#10003;</span>
              {f}
            </li>
          ))}
        </ul>
        <a
          href={plan.href}
          data-track={plan.event}
          data-tier={plan.tierSlug}
          data-form-start={plan.formStart}
          class="mt-8 block rounded-sm bg-teal p-3.5 text-center text-[0.75rem] font-medium uppercase tracking-[0.1em] text-canvas no-underline transition-colors hover:bg-mint"
        >
          {plan.cta}
        </a>
      </div>
    ))}
  </div>

  <!-- Custom request -->
  <div class="mt-6 flex flex-wrap items-center justify-between gap-6 rounded-sm border border-rule p-8">
    <div>
      <p class="font-display mb-1.5 text-[1.1rem] font-normal text-fg">{t.customTitle}</p>
      <p class="text-[0.85rem] leading-[1.6] text-fg-dim">
        {t.customBody}
      </p>
    </div>
    <a
       href="https://form.jotform.com/262568319503562"
       target="_blank"
       rel="noopener noreferrer"
       data-track="form_start"
       class="flex-shrink-0 rounded-sm border border-rule px-6 py-3 text-[0.75rem] font-medium uppercase tracking-[0.1em] text-fg no-underline transition-colors hover:border-teal hover:bg-teal/5"
    >
      {t.customCta}
    </a>
  </div>
</section>

<script is:inline>
  // Mobile pricing tabs synced with the swipeable track.
  (function () {
    var track = document.getElementById("pricing-track");
    if (!track) return;
    var tabs = Array.prototype.slice.call(document.querySelectorAll("[data-pricing-tab]"));
    if (!tabs.length) return;
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var syncing = false;
    function activate(i) {
      tabs.forEach(function (tab, j) {
        var on = i === j;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.classList.toggle("is-active", on);
      });
      // Featured ring belongs to the active slide (first card = Website).
      track.classList.toggle("show-featured", i === 0);
    }
    function cardStep() {
      var card = track.querySelector(":scope > div");
      return card ? card.offsetWidth + 16 : 320;
    }
    tabs.forEach(function (tab, i) {
      if (i === 0) tab.classList.add("is-active");
      tab.addEventListener("click", function () {
        syncing = true;
        activate(i);
        track.scrollTo({ left: i * cardStep(), behavior: reduce ? "auto" : "smooth" });
        setTimeout(function () { syncing = false; }, 450);
      });
    });
    var raf = 0;
    track.addEventListener("scroll", function () {
      if (syncing) return;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () {
        var i = Math.min(tabs.length - 1, Math.max(0, Math.round(track.scrollLeft / cardStep())));
        activate(i);
      });
    }, { passive: true });
  })();
</script>
