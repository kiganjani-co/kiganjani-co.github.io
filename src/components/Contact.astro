---
import { copy, type Lang } from "../i18n/copy";
const { lang = "en" }: { lang?: Lang } = Astro.props;
const t = copy[lang].contact;
---

<section id="contact" class="border-t border-rule px-[clamp(1.5rem,5vw,4rem)] py-[clamp(4rem,10vh,8rem)]">
  <div class="text-center">
    <p class="mb-4 text-[0.68rem] uppercase tracking-[0.24em] text-teal">{t.eyebrow}</p>
    <h2 class="font-display mb-6 text-[clamp(1.8rem,4vw,2.75rem)] font-normal leading-[1.2] text-fg">
      {t.heading}
    </h2>
    <p class="mb-10 mx-auto max-w-xl text-base leading-[1.85] text-fg-dim">
      {t.body}
    </p>
    <a
      href="https://form.jotform.com/262568319503562"
      target="_blank"
      rel="noopener noreferrer"
      data-track="whatsapp_click"
      data-placement="contact-footer"
      class="inline-flex items-center gap-3 rounded-sm border-none bg-teal px-8 py-4 text-[0.82rem] font-semibold uppercase tracking-[0.1em] text-canvas transition-colors hover:bg-mint"
    >
      Start Project
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </a>
  </div>
</section>
