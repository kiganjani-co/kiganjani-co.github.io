---
import ContactForm from "./ContactForm";
import { copy, type Lang } from "../i18n/copy";
const { lang = "en" }: { lang?: Lang } = Astro.props;
const t = copy[lang].contact;
const contactMethods = [
  { icon: "✆", href: "https://wa.me/255782506217?text=Hello%2C%20I%27m%20interested%20in%20your%20services", track: "whatsapp_click", placement: "contact" },
  { icon: "⊕", href: "https://instagram.com/kiganjani.co", track: undefined, placement: undefined },
  { icon: "◉", href: "#about", track: undefined, placement: undefined },
];
---

<section id="contact" class="border-t border-rule px-[clamp(1.5rem,5vw,4rem)] py-[clamp(4rem,10vh,8rem)]">
  <div class="contact-grid grid gap-16 items-start">
    <div>
      <p class="mb-6 text-[0.68rem] uppercase tracking-[0.24em] text-teal">{t.eyebrow}</p>
      <h2 class="font-display mb-6 text-[clamp(2rem,5vw,3.5rem)] font-normal leading-[1.15] text-fg">
        {t.heading}
      </h2>
      <p class="mb-10 text-base leading-[1.85] text-fg-dim">
        {t.body}
      </p>
      <div class="flex flex-col gap-4">
        <a
          href="#contact"
          id="email-link"
          data-track="cta_click"
          data-id="contact-email"
          data-email-user="wbalaile"
          data-email-domain="kiganjani-co.tech"
          class="flex items-center gap-4 rounded-sm border border-rule p-4 no-underline transition-colors hover:border-teal/40 hover:bg-teal/5"
        >
          <span
            class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-sm bg-teal/10 text-[0.9rem] text-teal"
          >
            ✉
          </span>
          <div>
            <p class="mb-0.5 text-[0.62rem] uppercase tracking-[0.14em] text-fg-dim">{t.emailLabel}</p>
            <p class="text-[0.9rem] text-fg">wbalaile&#64;kiganjani-co&#46;tech</p>
          </div>
        </a>
        {contactMethods.map((ct, i) => (
          <a
            href={ct.href}
            target={ct.href.startsWith("http") ? "_blank" : undefined}
            rel={ct.href.startsWith("http") ? "noopener noreferrer" : undefined}
            data-track={ct.track}
            data-placement={ct.placement}
            class="flex items-center gap-4 rounded-sm border border-rule p-4 no-underline transition-colors hover:border-teal/40 hover:bg-teal/5"
          >
            <span
              class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-sm bg-teal/10 text-[0.9rem] text-teal"
            >
              {ct.icon}
            </span>
            <div>
              <p class="mb-0.5 text-[0.62rem] uppercase tracking-[0.14em] text-fg-dim">{t.methods[i].label}</p>
              <p class="text-[0.9rem] text-fg">{t.methods[i].value}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <ContactForm client:visible lang={lang} />
  </div>
</section>

<script is:inline>
  // Assemble the email link at runtime so scrapers never see a plain address
  const emailLink = document.getElementById("email-link");
  emailLink?.addEventListener("click", (e) => {
    e.preventDefault();
    const user = emailLink.getAttribute("data-email-user");
    const domain = emailLink.getAttribute("data-email-domain");
    window.location.href = `mailto:${user}@${domain}`;
  });
</script>
