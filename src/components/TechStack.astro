---
import htmlIcon from "../assets/images/icons/html5-svgrepo-com.svg";
import cssIcon from "../assets/images/icons/css3-svgrepo-com.svg";
import jsIcon from "../assets/images/icons/javascript-svgrepo-com.svg";
import pythonIcon from "../assets/images/icons/python-svgrepo-com.svg";
import mysqlIcon from "../assets/images/icons/mysql-svgrepo-com.svg";
import bootstrapIcon from "../assets/images/icons/bootstrap-svgrepo-com.svg";
import vueIcon from "../assets/images/icons/vue-dot-js-svgrepo-com.svg";
import expressIcon from "../assets/images/icons/express-svgrepo-com.svg";
import mongodbIcon from "../assets/images/icons/mongodb-svgrepo-com.svg";
import githubIcon from "../assets/images/icons/github-svgrepo-com.svg";
import nodeIcon from "../assets/images/icons/node-dot-js-svgrepo-com.svg";

const techStack = [
  { name: "HTML", icon: htmlIcon },
  { name: "CSS", icon: cssIcon },
  { name: "JavaScript", icon: jsIcon },
  { name: "Python", icon: pythonIcon },
  { name: "SQL", icon: mysqlIcon },
  { name: "Bootstrap", icon: bootstrapIcon },
  { name: "Vue.js", icon: vueIcon },
  { name: "Express", icon: expressIcon },
  { name: "MongoDB", icon: mongodbIcon },
  { name: "MySQL", icon: mysqlIcon },
  { name: "GitHub", icon: githubIcon },
  { name: "Node.js", icon: nodeIcon },
];

const tripled = [...techStack, ...techStack, ...techStack];
---

<section id="tech-stack" class="overflow-hidden border-t border-rule bg-canvas-mid py-[clamp(2rem,4vh,3rem)]">
  <div class="mb-12 px-[clamp(1.5rem,5vw,4rem)]">
    <p class="text-[0.68rem] uppercase tracking-[0.24em] text-teal">Tech Stack</p>
  </div>
  <div
    class="tech-carousel"
    style="mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);"
  >
    <div class="tech-track">
      {tripled.map((item, i) => (
        <div
          class="flex flex-shrink-0 items-center gap-2 rounded-sm border border-rule bg-canvas px-4 py-2"
        >
          <img
            src={item.icon.src}
            alt={item.name}
            class="h-[18px] w-[18px] flex-shrink-0 opacity-80"
          />
          <span class="whitespace-nowrap text-[0.7rem] font-medium text-fg-dim">{item.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
