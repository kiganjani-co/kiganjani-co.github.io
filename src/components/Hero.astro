---
---

<section
  class="relative grid min-h-screen items-center overflow-hidden px-[clamp(1.5rem,5vw,4rem)] pt-[clamp(6rem,12vh,9rem)] pb-[clamp(4rem,8vh,6rem)]"
>
  <!-- Teal radial glow -->
  <div
    class="pointer-events-none absolute -right-[10vw] -top-[10vh] h-[60vh] w-[60vw]"
    style="background: radial-gradient(ellipse at center, rgba(0,210,181,0.1) 0%, transparent 70%);"
  ></div>

  <div class="relative max-w-[920px]">
    <h1
      class="font-display mb-10 text-[clamp(2.8rem,8vw,5rem)] font-normal leading-[1.05] tracking-[-0.02em] text-fg"
    >
      We build the digital<br />
      infrastructure <em class="italic text-teal">your business<br />needs to grow.</em>
    </h1>
    <p
      class="mb-12 max-w-[500px] text-[clamp(1rem,2vw,1.15rem)] leading-[1.8] text-fg-dim"
    >
      A solo agency with the precision of a specialist and the range of a full-service
      studio. Websites, e-commerce, and custom applications — built to convert.
    </p>
    <div class="flex flex-wrap items-center gap-4">
      <a
        href="#contact"
        class="inline-block rounded-sm bg-teal px-8 py-3.5 text-[0.82rem] font-medium uppercase tracking-[0.1em] text-canvas no-underline transition-colors hover:bg-mint"
      >
        Start a project
      </a>
      <a
        href="#work"
        class="inline-flex items-center gap-2 text-[0.82rem] uppercase tracking-[0.1em] text-fg-dim no-underline transition-colors hover:text-fg"
      >
        See work
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8 3l5 5-5 5M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </div>
</section>
