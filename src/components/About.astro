---
import devPhoto from "../assets/images/kiganjani-dev.jpg";
import ContactForm from "./ContactForm";
import { copy, type Lang } from "../i18n/copy";
const { lang = "en" }: { lang?: Lang } = Astro.props;
const t = copy[lang].about;
const ct = copy[lang].contact;
const contactMethods = [
  { icon: "✆", href: "https://wa.me/255782506217?text=Hello%2C%20I%27m%20interested%20in%20your%20services", track: "whatsapp_click", placement: "about" },
  { icon: "⊕", href: "https://instagram.com/kiganjani.co", track: undefined, placement: undefined },
  { icon: "◉", href: "#about", track: undefined, placement: undefined },
];
---

<section id="about" class="border-t border-rule px-[clamp(1.5rem,5vw,4rem)] py-[clamp(4rem,10vh,8rem)]">
  <div class="about-grid">
    <div class="relative flex-shrink-0">
      <div
        class="about-frame pointer-events-none absolute rounded-sm border border-teal/35"
      ></div>
      <img
        src={devPhoto.src}
        alt={t.imgAlt}
        width="1024"
        height="1024"
        loading="lazy"
        decoding="async"
        class="h-[480px] w-full rounded-sm object-cover bg-[#ccc] block"
      />
      <div
        class="absolute bottom-6 left-6 rounded-sm border-l-2 border-teal bg-caption-bg px-5 py-3 backdrop-blur-sm"
      >
        <p class="font-display text-base font-normal text-fg">{t.name}</p>
        <p class="mt-0.5 text-[0.65rem] uppercase tracking-[0.14em] text-teal">
          {t.role}
        </p>
      </div>
    </div>

    <div class="flex flex-col justify-center">
      <p class="mb-6 text-[0.68rem] uppercase tracking-[0.24em] text-teal">{t.eyebrow}</p>
      <h2
        class="font-display mb-7 text-[clamp(1.8rem,4vw,2.75rem)] font-normal leading-[1.2] text-fg"
      >
        {t.h1a}<br />{t.h1b}
      </h2>
      <p class="mb-5 text-base leading-[1.85] text-fg-dim">
        {t.p1}
      </p>
      <p class="mb-5 text-base leading-[1.85] text-fg-dim">
        {t.p2}
      </p>
      <p class="text-base leading-[1.85] text-fg-dim">
        {t.p3}
      </p>
    </div>
  </div>

  <div class="mt-20 pt-16 border-t border-rule">
    <p class="mb-6 text-[0.68rem] uppercase tracking-[0.24em] text-teal">{ct.eyebrow}</p>
    <h3 class="font-display mb-6 text-[clamp(1.5rem,3vw,2.25rem)] font-normal leading-[1.2] text-fg">
      {ct.heading}
    </h3>
    <p class="mb-10 text-base leading-[1.85] text-fg-dim">
      {ct.body}
    </p>
    <div class="flex flex-col-4 gap-4 mb-12">
      <a
        href="#about"
        id="email-link-about"
        data-track="cta_click"
        data-id="contact-email-about"
        data-email-user="wbalaile"
        data-email-domain="kiganjani-co.tech"
        class="flex items-center gap-4 rounded-sm border border-rule p-4 no-underline transition-colors hover:border-teal/40 hover:bg-teal/5"
      >
        <span
          class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-sm bg-teal/10 text-[0.9rem] text-teal"
        >
          ✉
        </span>
        <div>
          <p class="mb-0.5 text-[0.62rem] uppercase tracking-[0.14em] text-fg-dim">{ct.emailLabel}</p>
          <p class="text-[0.9rem] text-fg">wbalaile&#64;kiganjani-co&#46;tech</p>
        </div>
      </a>
      {contactMethods.map((cm, i) => (
        <a
          href={cm.href}
          target={cm.href.startsWith("http") ? "_blank" : undefined}
          rel={cm.href.startsWith("http") ? "noopener noreferrer" : undefined}
          data-track={cm.track}
          data-placement={cm.placement}
          class="flex items-center gap-4 rounded-sm border border-rule p-4 no-underline transition-colors hover:border-teal/40 hover:bg-teal/5"
        >
          <span
            class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-sm bg-teal/10 text-[0.9rem] text-teal"
          >
            {cm.icon}
          </span>
          <div>
            <p class="mb-0.5 text-[0.62rem] uppercase tracking-[0.14em] text-fg-dim">{ct.methods[i].label}</p>
            <p class="text-[0.9rem] text-fg">{ct.methods[i].value}</p>
          </div>
        </a>
      ))}
    </div>

    <details class="group border border-rule rounded-sm overflow-hidden">
      <summary
        class="flex items-center justify-between cursor-pointer rounded-sm border-none bg-teal/5 p-5 no-underline transition-colors hover:bg-teal/10 list-none"
        aria-expanded="false"
      >
        <span class="flex items-center gap-3 text-[0.8rem] font-medium text-fg">
          <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-sm bg-teal/10 text-teal">✎</span>
          <span>{ct.eyebrow}</span>
        </span>
        <span class="flex items-center gap-2 text-[0.7rem] uppercase tracking-[0.14em] text-teal transition-transform group-open:rotate-180">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </span>
      </summary>
      <div class="border-t border-rule p-6">
        <ContactForm client:visible lang={lang} />
      </div>
    </details>
  </div>
</section>

<script is:inline>
  // Assemble the email link at runtime so scrapers never see a plain address
  const emailLink = document.getElementById("email-link-about");
  emailLink?.addEventListener("click", (e) => {
    e.preventDefault();
    const user = emailLink.getAttribute("data-email-user");
    const domain = emailLink.getAttribute("data-email-domain");
    window.location.href = `mailto:${user}@${domain}`;
  });
</script>
