---
import { copy, type Lang } from "../i18n/copy";
const { lang = "en" }: { lang?: Lang } = Astro.props;
const t = copy[lang].faq;
const faqs = t.items;
---

<section id="faq" class="border-t border-rule bg-canvas-mid px-[clamp(1.5rem,5vw,4rem)] py-[clamp(4rem,10vh,8rem)]">
  <div class="faq-split">
    <div>
      <p class="mb-4 text-[0.68rem] uppercase tracking-[0.24em] text-teal">FAQ</p>
      <h2 class="font-display text-[clamp(2rem,5vw,3.5rem)] font-normal leading-[1.1] text-fg">
        {t.heading}
      </h2>
    </div>
    <div>
      {faqs.map((f) => (
        <details class="faq-item">
          <summary class="faq-q">
            <span>{f.q}</span>
            <span class="faq-plus" aria-hidden="true">+</span>
          </summary>
          <p class="faq-a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
