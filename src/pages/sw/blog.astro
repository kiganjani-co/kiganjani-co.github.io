---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { copy } from "../../i18n/copy";

const t = copy.sw.blogPage;
---

<Layout lang="sw" title={t.metaTitle} description={t.metaDesc}>
  <Nav lang="sw" />
  <section class="mx-auto max-w-3xl px-6 pt-36 pb-24">
    <p class="mb-6 text-[0.68rem] uppercase tracking-[0.24em] text-teal">{t.eyebrow}</p>
    <h1 class="font-display text-[2.5rem] leading-[1.1] text-fg mb-8">{t.h1}</h1>
    <p class="mb-12 text-base leading-[1.8] text-fg-dim">
      {t.intro}
    </p>

    <div class="rounded-sm border border-rule p-10">
      <p class="font-display mb-4 text-[1.25rem] text-fg">{t.cardTitle}</p>
      <p class="mb-8 text-[0.9rem] leading-[1.7] text-fg-dim">
        {t.cardBody}
      </p>
      <a
        href="https://kiganjani-co.hashnode.dev/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-sm bg-teal px-8 py-3.5 text-[0.82rem] font-medium uppercase tracking-[0.1em] text-canvas no-underline transition-colors hover:bg-mint"
      >
        {t.cta}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M4.5 11.5l7-7M5 4.5h7v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>
  <Footer lang="sw" />
</Layout>
