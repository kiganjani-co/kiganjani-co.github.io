---
import Layout from "../../../layouts/Layout.astro";
import Nav from "../../../components/Nav.astro";
import Footer from "../../../components/Footer.astro";
import { copy } from "../../../i18n/copy";
import projects from "../../../content/projects.json";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project: item } = Astro.props;
const project = { ...item, ...item.sw };
const t = copy.sw.casePage;
const related = projects
  .filter((p) => p.slug !== project.slug)
  .map((p) => ({ ...p, ...p.sw }));

const whatsapp =
  "https://wa.me/255782506217?text=Hello%2C%20I%27m%20interested%20in%20your%20services";
const calendly = "https://calendly.com/kiganjani-co/discovery-call";
---

<Layout lang="sw" title={`${project.title} — Kiganjani Co.`} description={project.description}>
  <Nav lang="sw" />

  <section class="mx-auto max-w-3xl px-6 pt-36 pb-16">
    <p class="mb-4 text-[0.68rem] uppercase tracking-[0.24em] text-teal">{t.eyebrow}</p>
    <h1 class="font-display text-[clamp(2rem,5vw,3.25rem)] font-normal leading-[1.1] text-fg">
      {project.title}
    </h1>
    <div class="mt-6 flex flex-wrap items-center gap-3">
      <span class="text-[0.62rem] uppercase tracking-[0.18em] text-teal">{project.category}</span>
      {project.tags.map((tag) => (
        <span class="rounded-sm border border-teal/30 px-2.5 py-1 text-[0.65rem] uppercase tracking-[0.1em] text-teal">
          {tag}
        </span>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16">
    <img
      src={project.image}
      alt={project.title}
      width="800"
      height="500"
      loading="eager"
      decoding="async"
      class="h-auto w-full rounded-sm object-cover"
    />
    <p class="mt-8 text-[0.95rem] leading-[1.8] text-fg-dim">{project.description}</p>
    <p class="mt-6 text-[0.85rem] leading-[1.7] text-fg-dim">
      {t.processNote}{" "}
      <a href="/sw/process" class="text-teal underline">{t.processLink}</a>
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16">
    <h2 class="font-display mb-6 text-[1.5rem] font-normal text-fg">{t.relatedTitle}</h2>
    <div class="flex flex-col gap-px border border-rule bg-rule">
      {related.map((p) => (
        <a
          href={`/sw/work/${p.slug}`}
          data-track="cta_click"
          data-id={`work-${p.slug}`}
          class="flex items-center justify-between gap-4 bg-canvas p-6 no-underline transition-colors hover:bg-card-hover"
        >
          <div>
            <p class="mb-1 text-[0.62rem] uppercase tracking-[0.18em] text-teal">{p.category}</p>
            <p class="font-display text-[1.05rem] font-normal text-fg">{p.title}</p>
          </div>
          <span class="flex-shrink-0 text-teal">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-24">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-sm border border-rule p-8">
      <div>
        <p class="font-display mb-1.5 text-[1.1rem] font-normal text-fg">{t.ctaTitle}</p>
        <p class="text-[0.85rem] leading-[1.6] text-fg-dim">
          {t.ctaBody}
        </p>
      </div>
      <div class="flex flex-shrink-0 flex-wrap gap-3">
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp_click"
          data-placement="case"
          class="rounded-sm bg-teal px-6 py-3 text-[0.75rem] font-medium uppercase tracking-[0.1em] text-canvas no-underline transition-colors hover:bg-mint"
        >
          {t.waBtn}
        </a>
        <a
          href={calendly}
          target="_blank"
          rel="noopener noreferrer"
          data-track="calendly_click"
          class="rounded-sm border border-rule px-6 py-3 text-[0.75rem] font-medium uppercase tracking-[0.1em] text-fg no-underline transition-colors hover:border-teal hover:bg-teal/5"
        >
          {t.calBtn}
        </a>
      </div>
    </div>
  </section>

  <Footer lang="sw" />
</Layout>
