---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { copy } from "../../i18n/copy";

const t = copy.sw.servicesPage;

const whatsapp =
  "https://wa.me/255782506217?text=Hello%2C%20I%27m%20interested%20in%20your%20services";
const calendly = "https://calendly.com/kiganjani-co/discovery-call";
---

<Layout lang="sw" title={t.metaTitle} description={t.metaDesc}>
  <Nav lang="sw" />

  <section class="mx-auto max-w-3xl px-6 pt-36 pb-16">
    <p class="mb-4 text-[0.68rem] uppercase tracking-[0.24em] text-teal">{t.eyebrow}</p>
    <h1 class="font-display text-[clamp(2rem,5vw,3.25rem)] font-normal leading-[1.1] text-fg">
      {t.h1}
    </h1>
    <p class="mt-6 text-[0.95rem] leading-[1.8] text-fg-dim">
      {t.intro}
    </p>
  </section>

  {t.services.map((s) => (
    <section id={s.slug} class="border-t border-rule px-[clamp(1.5rem,5vw,4rem)] py-[clamp(4rem,10vh,8rem)]">
      <div class="mx-auto max-w-3xl">
        <div class="mb-4 flex items-baseline justify-between gap-4">
          <p class="text-[0.62rem] uppercase tracking-[0.18em] text-teal">
            {s.number} · {s.title}
          </p>
          <p class="font-display flex-shrink-0 text-[1rem] font-normal text-fg">{s.price}</p>
        </div>
        <h2 class="font-display mb-2 text-[clamp(1.5rem,3.5vw,2.25rem)] font-normal leading-[1.15] text-fg">
          {s.tagline}
        </h2>
        {s.body.map((p) => (
          <p class="mb-4 text-[0.95rem] leading-[1.8] text-fg-dim">{p}</p>
        ))}
        <ul class="m-0 mt-6 grid list-none gap-2.5 p-0 sm:grid-cols-2">
          {s.includes.map((item) => (
            <li class="flex items-start gap-2.5 text-[0.82rem] leading-[1.5] text-fg-dim">
              <span class="mt-0.5 flex-shrink-0 text-teal">&#10003;</span>
              {item}
            </li>
          ))}
        </ul>
        <a
          href={s.ctaHref}
          data-track="cta_click"
          data-id={`services-${s.slug}`}
          class="mt-8 inline-block rounded-sm bg-teal px-6 py-3 text-[0.75rem] font-medium uppercase tracking-[0.1em] text-canvas no-underline transition-colors hover:bg-mint"
        >
          {s.cta}
        </a>
      </div>
    </section>
  ))}

  <section class="mx-auto max-w-3xl px-6 pb-24">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-sm border border-rule p-8">
      <div>
        <p class="font-display mb-1.5 text-[1.1rem] font-normal text-fg">{t.ctaTitle}</p>
        <p class="text-[0.85rem] leading-[1.6] text-fg-dim">
          {t.ctaBody}
        </p>
      </div>
      <div class="flex flex-shrink-0 flex-wrap gap-3">
        <a
          href={whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp_click"
          data-placement="services"
          class="rounded-sm bg-teal px-6 py-3 text-[0.75rem] font-medium uppercase tracking-[0.1em] text-canvas no-underline transition-colors hover:bg-mint"
        >
          {t.waBtn}
        </a>
        <a
          href={calendly}
          target="_blank"
          rel="noopener noreferrer"
          data-track="calendly_click"
          class="rounded-sm border border-rule px-6 py-3 text-[0.75rem] font-medium uppercase tracking-[0.1em] text-fg no-underline transition-colors hover:border-teal hover:bg-teal/5"
        >
          {t.calBtn}
        </a>
      </div>
    </div>
  </section>

  <Footer lang="sw" />
</Layout>
