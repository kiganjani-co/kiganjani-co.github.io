---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { copy } from "../../i18n/copy";

const t = copy.sw.processPage;
const formUrl = "https://form.jotform.com/262568319503562";
---

<Layout lang="sw" title={t.metaTitle} description={t.metaDesc}>
  <Nav lang="sw" />

  <section class="mx-auto max-w-3xl px-6 pt-36 pb-16">
    <p class="mb-4 text-[0.68rem] uppercase tracking-[0.24em] text-teal">{t.eyebrow}</p>
    <h1 class="font-display text-[clamp(2rem,5vw,3.25rem)] font-normal leading-[1.1] text-fg">
      {t.h1}
    </h1>
    <p class="mt-6 text-[0.95rem] leading-[1.8] text-fg-dim">
      {t.intro}
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16">
    <div class="flex flex-col gap-px border border-rule bg-rule">
      {t.steps.map((s) => (
        <div class="bg-canvas p-8">
          <div class="mb-4 flex items-baseline justify-between gap-4">
            <p class="text-[0.62rem] uppercase tracking-[0.18em] text-teal">
              Hatua {s.n} · {s.title}
            </p>
            <p class="flex-shrink-0 text-[0.65rem] uppercase tracking-[0.1em] text-fg-dim">{s.days}</p>
          </div>
          <p class="text-[0.9rem] leading-[1.75] text-fg-dim">{s.desc}</p>
          <ul class="m-0 mt-5 flex list-none flex-col gap-2.5 p-0">
            {s.includes.map((item) => (
              <li class="flex items-start gap-2.5 text-[0.82rem] leading-[1.5] text-fg-dim">
                <span class="mt-0.5 flex-shrink-0 text-teal">&#10003;</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-16">
    <p class="text-center text-[0.85rem] leading-[1.7] text-fg-dim">
      {t.scopeNote}
    </p>
  </section>

  <section class="mx-auto max-w-3xl px-6 pb-24">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-sm border border-rule p-8">
      <div>
        <p class="font-display mb-1.5 text-[1.1rem] font-normal text-fg">{t.ctaTitle}</p>
        <p class="text-[0.85rem] leading-[1.6] text-fg-dim">
          {t.ctaBody}
        </p>
      </div>
      <div class="flex flex-shrink-0 flex-wrap gap-3">
        <a
          href={formUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track="form_start"
          class="rounded-sm bg-teal px-6 py-3 text-[0.75rem] font-medium uppercase tracking-[0.1em] text-canvas no-underline transition-colors hover:bg-mint"
        >
          {t.calBtn}
        </a>
      </div>
    </div>
  </section>

  <Footer lang="sw" />
</Layout>
